{
  "$description": "Direction artistique Corentin Delmée Coaching — SOURCE UNIQUE des tokens pour tout nouvel élément (écran, visuel réseaux, document, page web). Valeurs relevées dans l'app (getComputedStyle, 2026-11-17) et confrontées à src/styles/tokens.css (espace client) et src/coach/studio/tokens.css (espace coach Studio). Chaque token porte son nom CSS ('css') et son fichier ('source'). Vérification : node DA/outils/concordance.mjs. Génération de DA/tokens.css : node DA/outils/generer-tokens.mjs.",
  "$sources": {
    "client": "src/styles/tokens.css",
    "studio": "src/coach/studio/tokens.css"
  },
  "couleur": {
    "marque": {
      "jaune": { "valeur": "#F2E27A", "css": "--jaune", "source": "client", "usage": "Accent unique de la marque. Toujours en APLAT (fond de bouton, carte du jour, pastille) avec du texte foncé dessus. Jamais en texte sur fond clair." },
      "jaune-texte": { "valeur": "#26230A", "css": "--jaune-texte", "source": "client", "usage": "Texte posé sur le jaune (12 : 1)." },
      "encre": { "valeur": "#1A1B1E", "css": "--encre", "source": "client", "usage": "Surface « encre » (carte Coaching, en-tête de séance). Anthracite, jamais noir pur." },
      "creme": { "valeur": "#F1F2EF", "css": "--creme", "source": "client", "usage": "Texte sur l'encre." },
      "ok": { "valeur": "#46D9A8", "css": "--ok", "source": "client", "usage": "Validé (série faite, séance faite) : fond vert + texte foncé." },
      "ok-texte": { "valeur": "#0F2A22", "css": "--ok-texte", "source": "client", "usage": "Texte sur --ok (8,6 : 1)." },
      "scrim": { "valeur": "rgba(0, 0, 0, .5)", "css": "--scrim", "source": "client", "usage": "Voile derrière une feuille ou un menu." }
    },
    "ambiance": {
      "$description": "Espace client : 3 ambiances posées par html[data-ambiance]. Clair par défaut.",
      "fond": { "css": "--fond", "source": "client", "valeurs": { "clair": "#E3E5E8", "sombre": "#202224", "bleu": "#141B33" }, "usage": "Fond de page (« perle » en clair)." },
      "fond-profond": { "css": "--fond-profond", "source": "client", "valeurs": { "clair": "#D2D5DA", "sombre": "#16181A", "bleu": "#0B1024" }, "usage": "Derrière le menu (page qui recule)." },
      "surface": { "css": "--surface", "source": "client", "valeurs": { "clair": "#FFFFFF", "sombre": "#2B2E31", "bleu": "#1F2A4D" }, "usage": "Cartes, lignes de série." },
      "surface-2": { "css": "--surface-2", "source": "client", "valeurs": { "clair": "#EEF0F2", "sombre": "#363A3E", "bleu": "#2A3866" }, "usage": "Puces, boutons doux, cases de jour." },
      "texte": { "css": "--texte", "source": "client", "valeurs": { "clair": "#1B1D20", "sombre": "#F1F2EF", "bleu": "#EAF0FF" }, "usage": "Texte principal." },
      "texte-doux": { "css": "--texte-doux", "source": "client", "valeurs": { "clair": "#565B62", "sombre": "#A4A8AA", "bleu": "#97A4CC" }, "usage": "Sous-titres, méta, étiquettes." },
      "filet": { "css": "--filet", "source": "client", "valeurs": { "clair": "rgba(27, 29, 32, .12)", "sombre": "rgba(241, 242, 239, .12)", "bleu": "rgba(234, 240, 255, .14)" }, "usage": "Bordures fines, contour des boutons « contour »." },
      "ombre": { "css": "--ombre", "source": "client", "valeurs": { "clair": "rgba(40, 50, 70, .28)", "sombre": "rgba(0, 0, 0, .5)", "bleu": "rgba(2, 5, 20, .6)" }, "usage": "Couleur des ombres (cartes soulevées, feuilles)." },
      "accent-lisible": { "css": "--accent-lisible", "source": "client", "valeurs": { "clair": "#1B1D20", "sombre": "var(--jaune)", "bleu": "var(--jaune)" }, "usage": "Accent utilisé comme TEXTE ou trait : encre en clair, jaune en sombre/bleu." },
      "focus": { "css": "--focus", "source": "client", "valeurs": { "clair": "#1B1D20", "sombre": "var(--jaune)", "bleu": "var(--jaune)" }, "usage": "Contour de focus clavier (3 px, décalé de 3 px)." },
      "bien": { "css": "--bien", "source": "client", "valeurs": { "clair": "#17684D", "sombre": "var(--ok)", "bleu": "var(--ok)" }, "usage": "Vert en texte (progrès, record)." }
    },
    "phases": {
      "$description": "Écran de séance : préparation, travail (jaune + encre), repos (bleu ciel). Changement de phase = balayage, jamais un fondu.",
      "repos-bg": { "css": "--repos-bg", "source": "client", "valeurs": { "clair": "#CFE0F2", "sombre": "#2A3F6B", "bleu": "#31508F" }, "usage": "Fond de l'écran de repos." },
      "repos-fg": { "css": "--repos-fg", "source": "client", "valeurs": { "clair": "#16233D", "sombre": "#E8EEFA", "bleu": "#F2F6FF" }, "usage": "Chiffres et texte du repos." },
      "prep-bg": { "css": "--prep-bg", "source": "client", "valeurs": { "clair": "#1B1D20", "sombre": "#F1F2EF", "bleu": "#EAF0FF" }, "usage": "Fond de la préparation (inverse de l'ambiance)." },
      "prep-fg": { "css": "--prep-fg", "source": "client", "valeurs": { "clair": "#F1F2EF", "sombre": "#1B1D20", "bleu": "#141B33" }, "usage": "Texte de la préparation." },
      "travail-bg": { "valeur": "var(--accent)", "css": "--ph-travail-bg", "source": "client", "usage": "Travail = jaune." },
      "travail-fg": { "valeur": "var(--accent-texte)", "css": "--ph-travail-fg", "source": "client", "usage": "Texte du travail = encre du jaune." }
    },
    "surbrillance": {
      "surbrillance": { "valeur": "color-mix(in srgb, var(--accent) 22%, var(--surface))", "css": "--surbrillance", "source": "client", "usage": "Élément actif (ligne « aujourd'hui »), cerclé de 2 px de jaune." },
      "surbrillance-legere": { "valeur": "color-mix(in srgb, var(--accent) 16%, var(--surface))", "css": "--surbrillance-legere", "source": "client", "usage": "Plage (semaine dans le mois)." }
    },
    "studio": {
      "$description": "Espace coach « Studio » : fond lin chaud, même jaune, couleurs d'état, pastels par groupe musculaire. Limité à .st-app.",
      "fond": { "valeur": "#F4F1EC", "css": "--st-fond", "source": "studio", "usage": "Fond « lin » chaud, jamais blanc pur." },
      "surface": { "valeur": "#FFFFFF", "css": "--st-surface", "source": "studio", "usage": "Cartes, blocs, panneau." },
      "surface-2": { "valeur": "#EDE8E0", "css": "--st-surface-2", "source": "studio", "usage": "Encarts, champs, puces neutres." },
      "encre": { "valeur": "#23252B", "css": "--st-encre", "source": "studio", "usage": "Titres, bouton plein, barre d'onglets du téléphone, état « sélectionné »." },
      "texte": { "valeur": "#2B2D33", "css": "--st-texte", "source": "studio", "usage": "Texte courant." },
      "doux": { "valeur": "#5C5F66", "css": "--st-doux", "source": "studio", "usage": "Méta, sous-titres (5,7 : 1 sur le lin)." },
      "filet": { "valeur": "rgba(35, 37, 43, .10)", "css": "--st-filet", "source": "studio", "usage": "Séparateurs." },
      "filet-fort": { "valeur": "rgba(35, 37, 43, .18)", "css": "--st-filet-fort", "source": "studio", "usage": "Contour des boutons et champs." },
      "jaune": { "valeur": "#F2E27A", "css": "--st-jaune", "source": "studio", "usage": "Même jaune que le client : action principale, pastilles de compte." },
      "jaune-texte": { "valeur": "#26230A", "css": "--st-jaune-texte", "source": "studio", "usage": "Texte sur le jaune." },
      "ok": { "valeur": "#1B6B4C", "css": "--st-ok", "source": "studio", "usage": "Validé (texte)." },
      "ok-fond": { "valeur": "#DDF3E9", "css": "--st-ok-fond", "source": "studio", "usage": "Validé (fond)." },
      "alerte": { "valeur": "#A23B2A", "css": "--st-alerte", "source": "studio", "usage": "Douleur, suppression (texte ou fond plein avec blanc)." },
      "alerte-fond": { "valeur": "#FBE4DE", "css": "--st-alerte-fond", "source": "studio", "usage": "Alerte (fond)." },
      "propose": { "valeur": "#7A5A00", "css": "--st-propose", "source": "studio", "usage": "Proposé par Claude, à valider (texte)." },
      "propose-fond": { "valeur": "#FFF1C2", "css": "--st-propose-fond", "source": "studio", "usage": "Proposé par Claude (fond)." }
    },
    "muscles": {
      "$description": "Une teinte par groupe musculaire (Studio) : pastel en fond + encre de la même famille (≥ 6 : 1). Le nom du muscle est toujours écrit à côté.",
      "jambes": { "valeur": "#F7D9C4", "encre": "#7A3412", "css": "--m-jambes", "css-encre": "--m-jambes-i", "source": "studio" },
      "dos": { "valeur": "#CFE3F5", "encre": "#18476E", "css": "--m-dos", "css-encre": "--m-dos-i", "source": "studio" },
      "pecs": { "valeur": "#F5D0D6", "encre": "#7E2234", "css": "--m-pecs", "css-encre": "--m-pecs-i", "source": "studio" },
      "epaules": { "valeur": "#E3D6F5", "encre": "#4B2C7A", "css": "--m-epaules", "css-encre": "--m-epaules-i", "source": "studio" },
      "bras": { "valeur": "#D3EEDB", "encre": "#1C5C35", "css": "--m-bras", "css-encre": "--m-bras-i", "source": "studio" },
      "gainage": { "valeur": "#F3E7B8", "encre": "#5E4A00", "css": "--m-gainage", "css-encre": "--m-gainage-i", "source": "studio" },
      "mobilite": { "valeur": "#CDEDEC", "encre": "#135955", "css": "--m-mobilite", "css-encre": "--m-mobilite-i", "source": "studio" },
      "cardio": { "valeur": "#F9D5B8", "encre": "#7C3A05", "css": "--m-cardio", "css-encre": "--m-cardio-i", "source": "studio" }
    }
  },
  "typo": {
    "familles": {
      "titre": { "valeur": "'Syne', system-ui, sans-serif", "css": "--font-titre", "source": "client", "usage": "Titres et grands chiffres. Graisse 400-500, JAMAIS plus de 600. Interlettrage serré." },
      "texte": { "valeur": "'Albert Sans', system-ui, -apple-system, 'Segoe UI', sans-serif", "css": "--font-texte", "source": "client", "usage": "Tout le reste : texte, boutons, étiquettes." },
      "chiffres": { "valeur": "'Syne', system-ui, sans-serif", "css": "--font-chiffres", "source": "client", "usage": "Chiffres d'interface (date, KPI, heures)." },
      "chrono": { "valeur": "'Barlow Semi Condensed', system-ui, sans-serif", "css": "--font-chrono", "source": "client", "usage": "Chiffres des chronos (600, tabulaires). Choix provisoire (Barlow / Inter Tight / Azeret Mono)." },
      "studio-titre": { "valeur": "'Syne', system-ui, sans-serif", "css": "--st-titre", "source": "studio" },
      "studio-texte": { "valeur": "'Albert Sans', system-ui, -apple-system, 'Segoe UI', sans-serif", "css": "--st-sans", "source": "studio" }
    },
    "echelle": {
      "$description": "Tailles du client (px, multipliées par --e = 1 ou 1,2 en Grand affichage). Relevé : titre de page 42 px Syne 400 -.05em ; séance 30 px ; étiquettes 12 px capitales +.14em.",
      "display": { "valeur": "clamp(54px, 16vw, 68px)", "css": "--t-display", "source": "client", "usage": "« Fabien ? » de l'accueil, interligne .98, -.045em." },
      "page": { "valeur": "clamp(36px, 10.4vw, 42px)", "css": "--t-page", "source": "client", "usage": "Titre de page, interligne 1.02, -.03em." },
      "carte": { "valeur": "clamp(38px, 11vw, 46px)", "css": "--t-carte", "source": "client", "usage": "Titre de la carte du jour." },
      "menu": { "valeur": "clamp(24px, 6.9vw, 27px)", "css": "--t-menu", "source": "client", "usage": "Rubrique du menu." },
      "carte-petit": { "valeur": "21px", "css": "--t-carte-petit", "source": "client", "usage": "Titre des petites cartes." },
      "texte": { "valeur": "16px", "css": "--t-texte", "source": "client", "usage": "Texte courant." },
      "sous": { "valeur": "17px", "css": "--t-sous", "source": "client", "usage": "Sous-titre." },
      "mini": { "valeur": "14px", "css": "--t-mini", "source": "client", "usage": "Méta." },
      "chip": { "valeur": "13px", "css": "--t-chip", "source": "client", "usage": "Puce." },
      "etiquette": { "valeur": "12px", "css": "--t-etiq", "source": "client", "usage": "Étiquette en capitales (sur-titre)." },
      "ls-display": { "valeur": "-.045em", "css": "--ls-display", "source": "client" },
      "ls-titre": { "valeur": "-.03em", "css": "--ls-titre", "source": "client" },
      "ls-etiquette": { "valeur": ".14em", "css": "--ls-etiq", "source": "client" },
      "interligne": { "valeur": "1.4", "css": "--lh-texte", "source": "client" }
    },
    "studio": {
      "$description": "Studio : pas de variables de taille ; relevé : titre de page clamp(34px, 5vw, 56px) (40 px téléphone) Syne 500 -.035em ; titre de bloc 20 px ; texte 15 px / 1.45 ; méta 12,5-13,5 px ; étiquettes 12 px capitales +.1em."
    }
  },
  "espace": {
    "esp-1": { "valeur": "4px", "css": "--esp-1", "source": "client" },
    "esp-2": { "valeur": "8px", "css": "--esp-2", "source": "client" },
    "esp-3": { "valeur": "12px", "css": "--esp-3", "source": "client" },
    "esp-4": { "valeur": "16px", "css": "--esp-4", "source": "client" },
    "esp-5": { "valeur": "20px", "css": "--esp-5", "source": "client" },
    "esp-6": { "valeur": "24px", "css": "--esp-6", "source": "client" },
    "esp-8": { "valeur": "32px", "css": "--esp-8", "source": "client" },
    "esp-10": { "valeur": "40px", "css": "--esp-10", "source": "client" },
    "pad": { "valeur": "16px", "css": "--pad", "source": "client", "usage": "Marge latérale des pages (client)." },
    "pad-dash": { "valeur": "20px", "css": "--pad-dash", "source": "client", "usage": "Marge du tableau de bord." },
    "gap": { "valeur": "12px", "css": "--gap", "source": "client", "usage": "Écart entre cartes." },
    "cible": { "valeur": "calc(var(--e) * 48px)", "css": "--cible", "source": "client", "usage": "Zone à toucher minimale (client)." },
    "st-e-1": { "valeur": "4px", "css": "--st-e-1", "source": "studio" },
    "st-e-2": { "valeur": "8px", "css": "--st-e-2", "source": "studio" },
    "st-e-3": { "valeur": "12px", "css": "--st-e-3", "source": "studio" },
    "st-e-4": { "valeur": "16px", "css": "--st-e-4", "source": "studio" },
    "st-e-5": { "valeur": "20px", "css": "--st-e-5", "source": "studio" },
    "st-e-6": { "valeur": "24px", "css": "--st-e-6", "source": "studio" },
    "st-e-8": { "valeur": "32px", "css": "--st-e-8", "source": "studio" },
    "st-e-10": { "valeur": "40px", "css": "--st-e-10", "source": "studio" },
    "st-gouttiere": { "valeur": "clamp(16px, 3vw, 40px)", "css": "--st-gouttiere", "source": "studio", "usage": "Marge latérale de page (16 px sur téléphone)." },
    "st-pad-btn": { "valeur": "18px", "css": "--st-pad-btn", "source": "studio" },
    "st-pad-btn-petit": { "valeur": "12px", "css": "--st-pad-btn-petit", "source": "studio" },
    "st-pad-carte": { "valeur": "20px", "css": "--st-pad-carte", "source": "studio", "usage": "16 px sur téléphone." },
    "st-pad-champ": { "valeur": "14px", "css": "--st-pad-champ", "source": "studio" },
    "st-ecart": { "valeur": "8px", "css": "--st-ecart", "source": "studio" },
    "st-cible": { "valeur": "44px", "css": "--st-cible", "source": "studio" },
    "st-nav": { "valeur": "248px", "css": "--st-nav", "source": "studio", "usage": "Barre latérale (ordinateur)." }
  },
  "rayon": {
    "carte": { "valeur": "28px", "css": "--r-carte", "source": "client", "usage": "Cartes, pages, feuilles." },
    "rayon": { "valeur": "28px", "css": "--rayon", "source": "client" },
    "bouton": { "valeur": "22px", "css": "--r-btn", "source": "client", "usage": "Boutons, lignes de série, segments." },
    "colonne": { "valeur": "20px", "css": "--r-col", "source": "client" },
    "jour": { "valeur": "16px", "css": "--r-jour", "source": "client" },
    "puce": { "valeur": "15px", "css": "--r-chip", "source": "client" },
    "st-xl": { "valeur": "28px", "css": "--st-r-xl", "source": "studio", "usage": "Panneau, fiche, feuille." },
    "st-l": { "valeur": "20px", "css": "--st-r-l", "source": "studio", "usage": "Cartes, blocs." },
    "st-m": { "valeur": "14px", "css": "--st-r-m", "source": "studio", "usage": "Boutons, champs." },
    "st-s": { "valeur": "10px", "css": "--st-r-s", "source": "studio", "usage": "Petits éléments." }
  },
  "ombre": {
    "carte": { "valeur": "0 34px 60px var(--ombre)", "css": "--ombre-carte", "source": "client", "usage": "Carte soulevée (client)." },
    "plan": { "valeur": "-30px 0 60px var(--ombre)", "css": "--ombre-plan", "source": "client", "usage": "Page qui recule derrière le menu." },
    "feuille": { "valeur": "0 -20px 60px var(--ombre)", "css": "--ombre-feuille", "source": "client", "usage": "Feuille basse." },
    "st-1": { "valeur": "0 1px 2px rgba(35,37,43,.06), 0 2px 8px rgba(35,37,43,.05)", "css": "--st-ombre-1", "source": "studio", "usage": "Repos : toutes les cartes du Studio." },
    "st-2": { "valeur": "0 2px 6px rgba(35,37,43,.06), 0 18px 40px -12px rgba(35,37,43,.22)", "css": "--st-ombre-2", "source": "studio", "usage": "Survol, sélection." },
    "st-3": { "valeur": "0 30px 80px -20px rgba(35,37,43,.35)", "css": "--st-ombre-3", "source": "studio", "usage": "Panneau, toast, barre flottante." }
  },
  "mouvement": {
    "d-appui": { "valeur": ".1s", "css": "--d-appui", "source": "client", "usage": "Enfoncement au doigt (scale .97)." },
    "d-rapide": { "valeur": ".25s", "css": "--d-rapide", "source": "client" },
    "d-base": { "valeur": ".5s", "css": "--d-base", "source": "client", "usage": "Action fréquente (série validée → repos : cercle depuis le bouton)." },
    "d-page": { "valeur": ".85s", "css": "--d-page", "source": "client", "usage": "Navigation carte → page (elle montre d'où l'on vient)." },
    "d-menu": { "valeur": ".85s", "css": "--d-menu", "source": "client" },
    "ressort": { "valeur": "cubic-bezier(.34, 1.45, .64, 1)", "css": "--ressort", "source": "client", "usage": "Relâchement d'un bouton : 320 ms rebondi (relevé sur 172 éléments)." },
    "ease-vaul": { "valeur": "cubic-bezier(.32, .72, 0, 1)", "css": "--ease-vaul", "source": "client", "usage": "Tiroir, feuille, croix du menu." },
    "ease-sortie": { "valeur": "cubic-bezier(.16, 1, .3, 1)", "css": "--ease-sortie", "source": "client", "usage": "≈ expo.out : entrées." },
    "ease": { "valeur": "cubic-bezier(.23, 1, .32, 1)", "css": "--ease", "source": "client" },
    "st-d-appui": { "valeur": "120ms", "css": "--st-d-appui", "source": "studio" },
    "st-d-court": { "valeur": "220ms", "css": "--st-d-court", "source": "studio", "usage": "Survol (carte qui se soulève)." },
    "st-d-page": { "valeur": "240ms", "css": "--st-d-page", "source": "studio", "usage": "Entrée de page (aucune sortie)." },
    "st-d-base": { "valeur": "420ms", "css": "--st-d-base", "source": "studio", "usage": "Panneau (entrée)." },
    "st-d-panneau": { "valeur": "500ms", "css": "--st-d-panneau", "source": "studio", "usage": "Feuille basse, élément partagé." },
    "st-ressort": { "valeur": "cubic-bezier(.34, 1.4, .64, 1)", "css": "--st-ressort", "source": "studio" },
    "st-sortie": { "valeur": "cubic-bezier(.16, 1, .3, 1)", "css": "--st-sortie", "source": "studio" },
    "st-vaul": { "valeur": "cubic-bezier(.32, .72, 0, 1)", "css": "--st-vaul", "source": "studio" }
  }
}
